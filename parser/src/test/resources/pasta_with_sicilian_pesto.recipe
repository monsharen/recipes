metadata:
  name: Pasta with Sicilian pesto
  images:
    - https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_1200/hellofresh_s3/image/kramig-pasta-med-kyckling-a0b04061.jpg
  description: Pasta with Sicilian pesto

ingredients:
  - 50 g sliced-sundried-tomatoes
  - 2 tomatoes
  - 40 g basil
  - 70 g olive-oil
  - 100 g almonds
  - 50 g raisins
  - 1 garlic-clove
  - 200 g ricotta-cheese
  - 40 g parmesan-cheese
  - 400 g pasta-strozzapreti

actions:
  boil water (2l)
  boil pasta-strozzapreti (400g) > pasta-strozzapreti
  chop almonds (100g)
  roast almonds 10min > roasted-almonds
  roast garlic 10min while stirring > roasted-garlic
  combine pasta-strozzapreti, roasted-almonds, roasted-garlic,
