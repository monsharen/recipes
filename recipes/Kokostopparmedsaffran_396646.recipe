metadata:
  name: Kokostoppar med saffran
  images:
    - https://i.imgur.com/mm0n4NM.png
  description: From https://www.juligen.se/kokostoppar-med-saffran/ 

ingredients:
 - 60 g smör
 - 0.5 g saffran
 - 2 u ägg
 - 1 dl socker
 - 200 g riven kokos
 - 0.5 tsp vaniljsocker
 - 1 u apelsin (rivet skal och 2-3 msk saft)
 - 200 g mörk eller ljus choklad
 - 1 tbsp Cointreau
