metadata:
  name: Campari Sour
  images:
    - https://drinkoteket.se/wp-content/uploads/campari-sour.jpg
  description: From https://drinkoteket.se/recept/campari-sour/ 
  types: [Drink]
  estimatedPrepTime: 5 min
  servings: 1 drink

ingredients:
 - 5 cl Campari
 - 2.5 cl Citronjuice
 - 1 cl Apelsinjuice
 - 1.5 cl Sockerlag
 - 2 cl Äggvita

actions:
 - free_text Häll 5 cl Campari, 2.5 cl citronjuice, 1 cl apelsinjuice, 1.5 cl sockerlag och 2 cl äggvita i en shaker.
 - free_text Skaka drinken utan is så att äggvitan skummar sig.
 - free_text Fyll shakern med is och skaka drinken kall.
 - free_text Sila upp drinken i ett glas.
 - free_text Garnera med apelsin, citron eller ett maraschinokörsbär.
