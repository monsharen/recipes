metadata:
  name: Kladdkaka Grande
  images:
    - https://i.imgur.io/6pUW8Gr_d.webp?maxwidth=640&shape=thumb&fidelity=medium
  description: From https://www.mathem.se/recept/kladdkaka-grande?storeId=23&gclid=Cj0KCQiAofieBhDXARIsAHTTldrzLsPgSbXBKkUMHCIm4odjQRAir-YZ9Shpi-KfeqEYcC6S9wb7r4YaAv6oEALw_wcB 
  types: [Dessert]

ingredients:
 - 150 g smör
 - 3 u Ägg
 - 3 dl Strösocker
 - 3.5 dl Vetemjöl
 - 1 dl Kakao
 - 1 tsp Vaniljsocker
 - 1 nypa Salt Fint

actions:
 - free_text Sätt ugnen på 200 grader
 - free_text Smörj form, cirka 22 cm i diameter, med smör och täck med kokosflingor
 - free_text Smält 150 g smör
 - free_text Vispa ihop 3 st ägg och 3 dl strösocker lätt och rör ner det smälta smöret.
 - free_text Blanda 3.5 dl vetemjöl, 1 dl kakao, 1 tsk vaniljsocker och 1 nypa salt och rör ner i äggsmeten.
 - free_text Häll smeten i formen och grädda kakan i nedre delen av ugnen i 200 grader i cirka 12 minuter
