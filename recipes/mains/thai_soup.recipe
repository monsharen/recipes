metadata:
  name: Thai soup
  images:
    - https://i.imgur.com/bInE8oc.png
  description:
  types: [Main]

ingredients:
- 200 g chicken
- 1 u curry paste
- 1 u lemon grass
- 5 u garlic cloves
- 2 u spoons oil
- 1 u chili
- 1 u fresh ginger
- 1 u lime
- 1 u onion
- 1 u celery
- 1 u fish sauce
- 2 u cans coconut milk
- 1 u coriander
- 1 u red/green pepper
- 2 tbsp of turmeric for coloring


actions:
  - free_text Fry 200 g chicken in 2 spoons of oil in a pan
  - free_text Cut 1 onion and add to pan until lightly translucent
  - free_text Add the curry paste, 5 mashed garlic cloves, 1 lemon grass stalk and the fresh ginger and let it fry for 2 mins
  - free_text Add 1 red/green pepper and 2 tbsp turmeric
  - free_text Add 2 cans coconut milk, 1 celery, the fish sauce, 1 chili and let it simmer for 10 mins
  - free_text Add 1 lime and the coriander. Serve!
