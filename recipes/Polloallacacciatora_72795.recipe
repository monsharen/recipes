metadata:
  name: Pollo alla cacciatora
  images:
    - https://www.bjarefagel.se/wp-content/uploads/2020/07/Pollo-alla-Cacciatora-%E2%80%93-Toscanajagarens-kyckling_web.jpg
  description:  Servera med bred bandpasta, parmesan och bröd. From https://www.bjarefagel.se/recept/pollo-alla-cacciatora/ 
  types: [Main]
  estimatedPrepTime: 1 h
  servings: 4

ingredients:
 - 1 kg kycklinglårfilé med ben från Bjärefågel
 - 1 st kruka färsk rosmarin
 - 2 st vitlöksklyftor
 - 1 st citron
 - 2 msk tomatpuré
 - 1.5 dl vitt torrt vin
 - 1 msk sardellcrème
 - 1 dl svarta oliver
 - 2 msk kapris
 - 1 st mindre knippa bladpersilja
 - 4 msk olivolja. 2 msk till marinad + 2 msk till stekning
 - 1 nypa salt
 - 5 st svartpepparkorn
 - 1 tsk harissa
 - 1 st riven parmesan till servering

actions:
 - divider Marinera kycklingen
 - free_text Ta 3 st rejäla kvistar rosmarin och stöt tillsammans med 2 st vitlöksklyftor och 5 st svartpepparkorn
 - free_text Häll 2 msk olivolja i massan, blanda i rivet citronskal från 1 citron och salta.
 - free_text Gnid in kycklinglåren i massan och låt vila i rumstemperatur i 30 minuter.
 - divider Tillagning
 - free_text Hetta upp 2 msk olivolja i pannan och stek 1 kg kycklinglårfilé så att skinnet blir knaprigt.
 - free_text Rör samman 2 msk citronsaft med 2 msk tomatpuré, 1 tsk harissa och 1.5 dl vitt vin.
 - free_text Häll mixen över kycklingarna och låt sjuda ca 15 minuter.
 - free_text Lägg i 1 msk sardellcrème, 2 msk kapris och 1 dl svarta oliver och låt sjuda ytterligare 5 minuter.
 - free_text Rör ner 1 knippa finhackad bladpersilja och salta och peppra efter behag.
 - divider Servering
 - free_text Servera med bred bandpasta. Riv parmesan över och servera med bröd.
