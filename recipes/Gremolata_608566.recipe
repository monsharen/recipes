metadata:
  name: Gremolata
  images:
    - https://i.imgur.io/VNFlGHW_d.webp?maxwidth=640&shape=thumb&fidelity=medium
  description: From https://www.greatitalianchefs.com/recipes/ossobuco-alla-milanese-recipe 

ingredients:
 - 1 u bunch of parsley
 - 2 u lemons, zested
 - 2 u garlic cloves, grated

actions:
 - free_text Finely chop the parsley and place in a bowl
 - free_text Add the garlic and lemon zest and mix together
