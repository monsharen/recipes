metadata:
  name: Gremolata
  images:
    - https://i.imgur.io/VNFlGHW_d.webp?maxwidth=640&shape=thumb&fidelity=medium
  description: From https://www.greatitalianchefs.com/recipes/ossobuco-alla-milanese-recipe 
  types: [Side]

ingredients:
 - 1 u bunch of parsley
 - 2 u lemons, zested
 - 2 u garlic cloves, grated

actions:
 - free_text Finely chop 1 bunch of parsley and place in a bowl
 - free_text Add 2 grated garlic cloves and the zest of 2 lemons and mix together
